        "options": {
          "timeout": 60000
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        1180,
        880
      ],
      "name": "Промпт: модель",
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 3000,
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "const res = $input.first().json;\nconst choice = res.choices?.[0] || {};\nconst content = String(choice.message?.content || '');\n\nconst BLOCKED = '🚫 Модель отказалась описывать это фото.\\n\\nОбычно так бывает, если на фото:\\n• обнажённость или откровенные позы;\\n• ребёнок;\\n• кровь, насилие или оружие.\\n\\nПопробуйте другое фото.';\nconst FAILED = '🔴 Не получилось описать фото.\\n\\nВозможные причины:\\n• сервис сейчас перегружен;\\n• фото слишком тёмное, размытое или маленькое.\\n\\nПопробуйте ещё раз или пришлите другое фото.';\n\n// Фильтр модели: Gemini отвечает 200, но с finish_reason=content_filter\nif (choice.finish_reason === 'content_filter' || /PROHIBITED_CONTENT|SAFETY|blocked/i.test(content)) {\n  return [{ json: { ok: false, text: BLOCKED } }];\n}\n\n// JSON целиком или от первой { до последней } (если модель обернула в markdown)\nlet data = null;\ntry { data = JSON.parse(content); } catch {\n  const a = content.indexOf('{'), b = content.lastIndexOf('}');\n  if (a !== -1 && b > a) { try { data = JSON.parse(content.slice(a, b + 1)); } catch {} }\n}\n\nif (data?.error === 'unsafe') {\n  return [{ json: { ok: false, text: BLOCKED } }];\n}\nconst en = String(data?.prompt_en || '').trim();\nconst ru = String(data?.prompt_ru || '').trim();\nif (!en || !ru) {\n  return [{ json: { ok: false, text: FAILED } }];\n}\n\nconst esc = (s) => String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nreturn [\n  { json: { ok: true, text: `🇬🇧 <b>Промпт на английском</b> (нажмите, чтобы скопировать)\\n<pre>${esc(en)}</pre>` } },\n  { json: { ok: true, text: `🇷🇺 <b>Промпт на русском</b>\\n<pre>${esc(ru)}</pre>` } },\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
